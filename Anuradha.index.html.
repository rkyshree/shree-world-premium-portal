            window.open(`https://wa.me/${ownerWpNumber}?text=${encodeURIComponent(textMessage)}`, '_blank');
        }

        // अपडेटेड रिव्यू सबमिट फंक्शन जो सीधे व्हाट्सएप पर भेजता है
        function submitUserReviewSystem() {
