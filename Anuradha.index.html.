        function toggleInteractiveFlight(type) {
            const formWrapper = document.getElementById('conditionalFlightFormWrapper');
            document.getElementById('flight-dom-btn').classList.remove('btn-active-highlight');
            document.getElementById('flight-int-btn').classList.remove('btn-active-highlight');
            if (selectedInteractiveFlightType === type) {
                selectedInteractiveFlightType = ''; formWrapper.classList.add('hidden');
            } else {
                selectedInteractiveFlightType = type; formWrapper.classList.remove('hidden');
                document.getElementById(`flight-${type}-btn`).classList.add('btn-active-highlight');
            }
        }

        function showSuggestions(inputId, containerId) {
            const inputVal = document.getElementById(inputId).value.toLowerCase().trim();
            const container = document.getElementById(containerId);
            if (inputVal.length < 1) { container.classList.add('hidden'); return; }
            const filtered = airports.filter(a => a.name.toLowerCase().includes(inputVal) || a.code.toLowerCase().includes(inputVal));
            container.innerHTML = '';
            filtered.forEach(airport => {
                const item = document.createElement('div');
                item.className = "p-3 hover:bg-slate-100 cursor-pointer flex justify-between bg-white text-slate-800 text-xs border-b border-cyan-100";
                item.innerHTML = `<span>${airport.name}</span><span class="font-bold text-cyan-600">${airport.code}</span>`;
                item.onclick = function() { 
                    document.getElementById(inputId).value = `${airport.name} (${airport.code})`; 
                    container.classList.add('hidden'); 
                    speakAiExplanation(`आपने ${airport.name} चुना है।`);
                };
                container.appendChild(item);
            });
            container.classList.remove('hidden');
        }

        function selectPlatform(platform) {
            activePlatform = platform;
            document.getElementById('btn-instagram').classList.remove('btn-active-highlight');
            document.getElementById('btn-facebook').classList.remove('btn-active-highlight');
            document.getElementById(`btn-${platform}`).classList.add('btn-active-highlight');
            document.getElementById('selected-platform-label').innerText = `${platformData[platform].emoji} ${platformData[platform].label}`;
            const servicesContainer = document.getElementById('service-options-container');
            servicesContainer.innerHTML = '';
            platformData[platform].services.forEach((service) => {
                const btn = document.createElement('button');
                btn.className = `service-opt p-3 rounded-xl border text-xs sm:text-sm font-semibold text-center bg-white border-purple-200 text-slate-700 shadow-sm transition-all hover:border-purple-400 hover:bg-purple-50`;
                btn.innerText = serviceHindiLabels[service] || service;
                btn.onclick = () => {
                    speakAiExplanation(`आपने ${serviceHindiLabels[service] || service} चुना है।`);
                    selectService(btn, service);
                };
                servicesContainer.appendChild(btn);
            });
            document.getElementById('conditionalPlansWrapper').classList.add('hidden');
        }

        function selectService(buttonElement, serviceLabel) {
            activeServiceLabel = serviceLabel;
            document.querySelectorAll('.service-opt').forEach(btn => {
                btn.className = 'service-opt p-3 rounded-xl border text-xs sm:text-sm font-semibold text-center bg-white border-purple-200 text-slate-700 shadow-sm transition-all hover:border-purple-400 hover:bg-purple-50';
            });
            buttonElement.className = 'service-opt p-3 rounded-xl border text-xs sm:text-sm font-black text-center btn-active-highlight';
            document.getElementById('conditionalPlansWrapper').classList.remove('hidden');
            renderQuantities();
        }

        function renderQuantities() {
            const qtyContainer = document.getElementById('quantity-grid'); qtyContainer.innerHTML = '';
            const availablePackages = comprehensivePriceMatrix[activePlatform][activeServiceLabel] || [];
            availablePackages.forEach((pkg) => {
                const btn = document.createElement('button'); btn.id = `pkg-${pkg.qty}`;
                btn.className = `qty-opt flex items-center justify-between p-3.5 rounded-xl border font-bold text-sm bg-white border-purple-200 text-slate-800 shadow-sm transition-all hover:border-purple-400 hover:bg-purple-50`;
                btn.innerHTML = `<span>${parseInt(pkg.qty).toLocaleString('en-IN')} ${serviceHindiLabels[activeServiceLabel]}</span><span class="text-amber-600 font-black">₹${pkg.price}</span>`;
                btn.onclick = () => {
                    speakAiExplanation(`${pkg.qty} ${serviceHindiLabels[activeServiceLabel]}, ${pkg.price} रुपये में चुना गया है।`);
                    selectQuantity(pkg.qty, pkg.price);
                };
                qtyContainer.appendChild(btn);
            });
        }

        function selectQuantity(qty, price) {
            activeQuantity = qty; selectedPackagePrice = price;
            document.querySelectorAll('.qty-opt').forEach(btn => btn.className = 'qty-opt flex items-center justify-between p-3.5 rounded-xl border font-bold text-sm bg-white border-purple-200 text-slate-800 shadow-sm transition-all hover:border-purple-400 hover:bg-purple-50');
            if(document.getElementById(`pkg-${qty}`)) document.getElementById(`pkg-${qty}`).classList.add('btn-active-highlight');
            updatePriceUI(selectedPackagePrice);
        }

        function calculateCustomPrice() {
            const customInput = document.getElementById('custom-quantity-input').value.trim();
            if (customInput === "" || parseInt(customInput) <= 0) { renderQuantities(); return; }
            const userQty = parseInt(customInput);
            const availablePackages = comprehensivePriceMatrix[activePlatform][activeServiceLabel] || [];
            if (availablePackages.length === 0) return;

            let basePackage = availablePackages[0];
            let calculatedCost = (userQty / parseInt(basePackage.qty)) * basePackage.price;
            selectedPackagePrice = Math.round(calculatedCost * 1.20);
            activeQuantity = userQty.toString();
            updatePriceUI(selectedPackagePrice);
        }

        function updatePriceUI(price) {
            document.getElementById('custom-qty-display').innerText = `चुनी गई संख्या: ${activeQuantity}`;
            document.getElementById('display-final-price').innerText = `₹${price.toLocaleString('en-IN')}`;
        }

        function setPaymentPurpose(purpose) {
            activePaymentPurpose = purpose;
            document.querySelectorAll('.pay-purpose-btn').forEach(btn => btn.className = 'pay-purpose-btn py-3 px-3 rounded-xl border text-xs font-bold bg-white border-slate-300 text-slate-700 shadow-sm transition-all hover:bg-slate-50');
            let idMap = purpose === 'Instagram' ? 'pay-for-insta' : (purpose === 'Facebook' ? 'pay-for-fb' : 'pay-for-flight');
            document.getElementById(idMap).classList.add('btn-active-highlight');
            speakAiExplanation(`${purpose} काम के लिए पेमेंट ऑप्शन चुना गया है।`);
        }

        function updateLiveQRCode() {
            const amount = document.getElementById('pay-amount').value || "";
            document.getElementById('live-qr-img').src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=upi://pay?pa=rkyshree@indianbank%26pn=RajanKumarYadav%26am=${amount}%26cu=INR`;
        }

        function copyToClipboard(text) {
            const tempInput = document.createElement("input"); tempInput.value = text;
            document.body.appendChild(tempInput); tempInput.select(); document.execCommand("copy"); document.body.removeChild(tempInput);
            const toast = document.getElementById('toast-msg'); toast.classList.remove('hidden');
            setTimeout(() => { toast.classList.add('hidden'); }, 2000);
        }

