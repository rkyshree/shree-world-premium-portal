            const textMessage = `⭐ *नया कस्टमर रिव्यू* ⭐\n━━━━━━━━━━━━━━━━━━\n👤 *नाम:* ${name}\n📍 *शहर/राज्य:* ${location || 'N/A'}\n🌟 *रेटिंग:* ${rating}\n💬 *अनुभव:* ${msg}`;
            
            // सीधे व्हाट्सएप लिंक ओपन करना
            window.open(`https://wa.me/${ownerWpNumber}?text=${encodeURIComponent(textMessage)}`, '_blank');
            
