        function updateTracker() {
            const textElement = document.getElementById('liveDynamicText');
            if (!textElement) return;
            
            textElement.style.opacity = '0';
            setTimeout(() => {
                const randomState = totalStatesPool[Math.floor(Math.random() * totalStatesPool.length)];
                const randomServiceText = randomServicesPool[Math.floor(Math.random() * randomServicesPool.length)];
                const randomPeopleCount = Math.floor(Math.random() * (500 - 10 + 1)) + 10;
                
                textElement.innerHTML = `<strong>${randomState}</strong> से अभी <span class="live-number font-extrabold text-emerald-600">${randomPeopleCount}</span> लोगों ${randomServiceText}`;
                textElement.style.opacity = '1';
            }, 400);
        }

        function rotateReviewsSystem() {
            const targetContainer = document.getElementById('dynamicReviewBox');
            if (!targetContainer) return;

            targetContainer.style.opacity = '0';
            setTimeout(() => {
                const currentReview = comprehensiveReviewsPool[currentReviewIndex];
                targetContainer.innerHTML = `
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center space-x-2">
                            <span class="text-base font-black text-slate-900">${currentReview.name}</span>
                            <span class="text-[11px] text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200">📍 ${currentReview.loc}</span>
                        </div>
                        <span class="text-sm text-amber-500 font-bold">${currentReview.rating}</span>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-700 font-medium italic">"${currentReview.msg}"</p>
                `;
                targetContainer.style.opacity = '1';
                currentReviewIndex = (currentReviewIndex + 1) % comprehensiveReviewsPool.length;
            }, 400);
        }

        function toggleAccordion(id) {
            const el = document.getElementById(id);
            const icon = document.getElementById(`icon-${id}`);
            if (el.classList.contains('hidden')) {
                el.classList.remove('hidden'); if(icon) icon.innerText = '▲';
            } else {
                el.classList.add('hidden'); if(icon) icon.innerText = '▼';
            }
        }

        window.onload = function() {
            selectPlatform('instagram'); setPaymentPurpose('Instagram'); updateLiveQRCode();
            setInterval(updateTracker, 5000);
            rotateReviewsSystem();
            setInterval(rotateReviewsSystem, 10000);
            if ('speechSynthesis' in window) {
                window.speechSynthesis.getVoices(); // Pre-load TTS voices
            }
        };
    </script>
