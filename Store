store<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HisabKarLay - Your Own E-commerce App Development</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-red: #FE3231;
            --light-grey: #F1F1F1;
            --dark-text: #1F2937;
            --white: #FFFFFF;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--light-grey);
            color: var(--dark-text);
            margin: 0;
            padding: 0;
            line-height: 1.6;
        }

        /* Utility Classes */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .text-center { text-align: center; }
        .text-bold { font-weight: 700; }
        .text-semibold { font-weight: 600; }
        .btn-red {
            background-color: var(--primary-red);
            color: var(--white);
            border: none;
            padding: 15px 30px;
            border-radius: 50px;
            font-size: 1.1em;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        .btn-red:hover { background-color: #d82c2a; }

        /* Header */
        header {
            padding: 20px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header img { height: 40px; }
        header nav a {
            text-decoration: none;
            color: var(--dark-text);
            margin-left: 20px;
            font-weight: 600;
        }

        /* Hero Section */
        .hero {
            padding: 60px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .hero-text { flex: 1; padding-right: 40px; }
        .hero-text h1 { font-size: 3.5em; margin-bottom: 10px; line-height: 1.2; }
        .hero-text h2 { font-size: 1.5em; color: var(--primary-red); margin-top: 0; }
        .hero-text p { font-size: 1.1em; color: #555; }
        .hero-image { flex: 1; text-align: right; position: relative; }
        .hero-image img { max-width: 80%; height: auto; border-radius: 30px; box-shadow: 0 20px 50px rgba(0,0,0,0.1); }
        .floating-element { position: absolute; max-width: 80px; z-index: 10; opacity: 0.8; }
        .delivery-box { top: -20px; left: -30px; }
        .shopping-bags { bottom: 50px; left: -60px; }
        .notification-1 { top: 100px; right: 10%; background: var(--white); padding: 10px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        .notification-2 { top: 180px; right: 15%; background: var(--white); padding: 10px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }

        /* Features Section */
        .features { padding: 60px 0; }
        .feature-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
        .feature-card {
            background-color: var(--white);
            padding: 30px;
            border-radius: 15px;
            display: flex;
            align-items: flex-start;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }
        .feature-icon { margin-right: 20px; font-size: 2em; color: var(--primary-red); }
        .feature-content h3 { margin-top: 0; font-size: 1.3em; }

        /* Pricing Section */
        .pricing { padding: 60px 0; text-align: center; }
        .price-badge {
            display: inline-block;
            background-color: var(--white);
            padding: 20px 50px;
            border-radius: 50px;
            border: 2px solid var(--primary-red);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            margin-bottom: 40px;
        }
        .price-badge h4 { color: var(--primary-red); font-size: 2.5em; margin: 0; font-weight: 700; }
        .price-badge p { margin: 0; color: #555; }

        /* Trust Badges */
        .trust { padding: 60px 0; text-align: center; }
        .trust-grid { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; }
        .trust-badge { display: flex; align-items: center; gap: 10px; }
        .trust-icon { font-size: 1.5em; color: var(--primary-red); }

        /* CTA Section */
        .cta { padding: 60px 0; text-align: center; }
        .cta p { font-size: 1.2em; max-width: 600px; margin: 0 auto 30px; color: #555; }

        /* Contact Section */
        .contact { padding: 60px 0; background-color: var(--white); text-align: center; }
        .contact-grid { display: flex; flex-direction: column; align-items: center; gap: 20px; }
        .contact-item { display: flex; align-items: center; gap: 15px; font-size: 1.2em; }
        .contact-item svg { height: 25px; width: 25px; }

        /* Footer */
        footer { padding: 40px 0; text-align: center; border-top: 1px solid #eee; }
        footer p { color: #888; font-size: 0.9em; }

        /* Responsive Styles */
        @media (max-width: 992px) {
            .hero { flex-direction: column; text-align: center; }
            .hero-text { padding-right: 0; margin-bottom: 40px; }
            .hero-text h1 { font-size: 2.8em; }
            .hero-image { text-align: center; }
            .feature-grid { grid-template-columns: 1fr; }
            .floating-element { display: none; }
        }
    </style>
</head>
