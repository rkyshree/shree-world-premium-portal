<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shree Dairy Farm | Farm to Home</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        /* प्रीमियम कलर और फॉन्ट सेटिंग्स */
        :root {
            --primary-color: #2e7d32; /* हरा (Farm) */
            --secondary-color: #1565c0; /* नीला (Milk) */
            --bg-light: #f9fbe7;
            --white: #ffffff;
            --text-dark: #333333;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
        }

        /* Header & Navigation */
        header {
            background-color: var(--white);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 50px;
            max-width: 1200px;
            margin: auto;
        }

        .logo {
            font-size: 24px;
            font-weight: 600;
            color: var(--secondary-color);
        }
        
        .logo span { color: var(--primary-color); }

        .nav-links a {
            text-decoration: none;
            color: var(--text-dark);
            margin: 0 15px;
            font-weight: 600;
        }

        .nav-links a:hover { color: var(--primary-color); }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1596733430284-f7437764b1a9?q=80&w=1000&auto=format&fit=crop') center/cover;
            color: var(--white);
            text-align: center;
            padding: 100px 20px;
        }

        .hero h1 { font-size: 48px; margin-bottom: 10px; }
        .hero p { font-size: 20px; margin-bottom: 20px; }
        .live-status {
            background-color: #ff9800;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            display: inline-block;
            margin-bottom: 30px;
            font-weight: bold;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            margin: 5px;
        }

        .btn-whatsapp { background-color: #25D366; color: white; }
        .btn-call { background-color: var(--secondary-color); color: white; }

        /* Products Section */
        .section-title { text-align: center; margin: 50px 0 20px; font-size: 32px; color: var(--primary-color); }
        
        .product-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            max-width: 1200px;
            margin: auto;
            padding: 20px;
        }

        .product-card {
            background: var(--white);
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            width: 280px;
            padding: 20px;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .product-card:hover { transform: translateY(-5px); }
        .product-card img { width: 100px; height: 100px; object-fit: cover; margin-bottom: 15px; border-radius: 50%; }
        .product-title { font-size: 20px; margin-bottom: 10px; }
        .product-price { font-size: 18px; color: var(--secondary-color); font-weight: bold; margin-bottom: 15px; }

        /* Footer */
        footer {
            background-color: var(--text-dark);
            color: var(--white);
            text-align: center;
            padding: 20px;
            margin-top: 50px;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="nav-container">
            <div class="logo">Shree <span>Dairy Farm</span></div>
            <div class="nav-links">
                <a href="#home">होम</a>
                <a href="#products">उत्पाद</a>
                <a href="#subscription">सब्सक्रिप्शन</a>
                <a href="#gallery">गैलरी</a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <h1>ताज़ा दूध, सीधे खेत से आपके घर तक</h1>
        <p>"Farm to Home - 100% शुद्ध और प्राकृतिक"</p>
        <div class="live-status">🟢 आज का ताज़ा दूध उपलब्ध है (Live)</div>
        <br>
        <a href="#products" class="btn btn-call">ऑर्डर करें (Order Now)</a>
        <a href="https://wa.me/919451239239?text=नमस्ते%20Shree%20Dairy%20Farm!%20मुझे%20आपके%20उत्पादों%20के%20बारे%20में%20जानकारी%20चाहिए।" target="_blank" class="btn btn-whatsapp">WhatsApp पर मैसेज करें</a>
        <a href="tel:+919451239239" class="btn btn-call">Call Now</a>
    </section>

    <!-- Products Section -->
    <h2 class="section-title" id="products">हमारे उत्पाद (Our Products)</h2>
    <div class="product-grid">
        
        <!-- Product 1 -->
        <div class="product-card">
            <img src="https://cdn-icons-png.flaticon.com/512/2674/2674486.png" alt="Cow Milk">
            <h3 class="product-title">गाय का दूध</h3>
            <p>मात्रा: 1 लीटर</p>
            <p class="product-price">₹60 / लीटर</p>
            <button class="btn btn-whatsapp" onclick="buyOnWhatsApp('गाय का दूध', '1 लीटर', '60')">Buy Now</button>
        </div>

        <!-- Product 2 -->
        <div class="product-card">
            <img src="https://cdn-icons-png.flaticon.com/512/3050/3050148.png" alt="Buffalo Milk">
            <h3 class="product-title">भैंस का दूध</h3>
            <p>मात्रा: 1 लीटर</p>
            <p class="product-price">₹70 / लीटर</p>
            <button class="btn btn-whatsapp" onclick="buyOnWhatsApp('भैंस का दूध', '1 लीटर', '70')">Buy Now</button>
        </div>

        <!-- Product 3 -->
        <div class="product-card">
            <img src="https://cdn-icons-png.flaticon.com/512/5778/5778550.png" alt="Paneer">
            <h3 class="product-title">ताज़ा पनीर</h3>
            <p>मात्रा: 250 ग्राम</p>
            <p class="product-price">₹100 / 250g</p>
            <button class="btn btn-whatsapp" onclick="buyOnWhatsApp('ताज़ा पनीर', '250 ग्राम', '100')">Buy Now</button>
        </div>

        <!-- Product 4 -->
        <div class="product-card">
            <img src="https://cdn-icons-png.flaticon.com/512/8734/8734493.png" alt="Ghee">
            <h3 class="product-title">शुद्ध देसी घी</h3>
            <p>मात्रा: 1 लीटर</p>
            <p class="product-price">₹800 / लीटर</p>
            <button class="btn btn-whatsapp" onclick="buyOnWhatsApp('शुद्ध देसी घी', '1 लीटर', '800')">Buy Now</button>
        </div>
        
        <!-- Product 5 -->
        <div class="product-card">
            <img src="https://cdn-icons-png.flaticon.com/512/7295/7295444.png" alt="Organic Manure">
            <h3 class="product-title">जैविक खाद (गोबर)</h3>
            <p>मात्रा: 50 किलो</p>
            <p class="product-price">₹200 / बोरी</p>
            <button class="btn btn-whatsapp" onclick="buyOnWhatsApp('जैविक खाद', '50 किलो', '200')">Buy Now</button>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Shree Dairy Farm. All Rights Reserved.</p>
        <p>संपर्क: 9451239239</p>
    </footer>

    <!-- JavaScript for WhatsApp Redirection -->
    <script>
        function buyOnWhatsApp(productName, quantity, price) {
            // आपका व्हाट्सएप नंबर 
            const phoneNumber = "919451239239"; 
            
            // कस्टमर के लिए प्री-फिल्ड मैसेज 
            const message = `नमस्ते Shree Dairy Farm! 🥛\n\nमुझे ऑर्डर करना है:\n*उत्पाद:* ${productName}\n*मात्रा:* ${quantity}\n*कीमत:* ₹${price}\n\nकृपया मुझे डिलीवरी और पेमेंट (UPI/COD) की जानकारी दें। अपना नाम, पता और मोबाइल नंबर मैं नीचे भेज रहा/रही हूँ:\n\nनाम: \nपता: `;
            
            // व्हाट्सएप API URL बनाना
            const whatsappURL = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;
            
            // यूज़र को व्हाट्सएप पर रीडायरेक्ट करना
            window.open(whatsappURL, '_blank');
        }
    </script>

</body>
</html>
